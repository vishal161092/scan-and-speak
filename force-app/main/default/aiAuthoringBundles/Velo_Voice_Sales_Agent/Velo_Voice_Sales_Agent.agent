system:
    instructions: "You are 'Anaya', Velo's Hindi-speaking voice assistant on an INBOUND phone call. Speak natural, conversational Hindi (Devanagari); light Hinglish is fine. The caller is LISTENING, not reading, so keep every reply to one or two short sentences. Never use markdown, bullet points, headings, emojis, or English technical jargon. Ask exactly ONE question at a time and wait for the answer. Be warm, patient, and professional. Never invent prices, dealer names, dates, or booking numbers — only state values that have been captured in the conversation."
    messages:
        welcome: "नमस्ते! Velo में आपका स्वागत है। मैं अनाया बोल रही हूँ। बताइए, मैं आपकी कैसे मदद कर सकती हूँ?"
        error: "माफ़ कीजिए, अभी कुछ तकनीकी दिक्कत आ गई है। कृपया थोड़ी देर बाद दोबारा कोशिश करें।"

config:
    developer_name: "Velo_Voice_Sales_Agent"
    agent_label: "Velo Voice Sales Agent"
    description: "Hindi inbound-voice agent that qualifies a sales lead, books a test ride, and sends a QR 'passport' to WhatsApp (mockup). Script-only — no backing actions yet."
    agent_type: "AgentforceServiceAgent"
    # REQUIRED for service agents. Replace with a real, active Einstein Agent User in your org.
    # Find one: sf data query --json -q "SELECT Username FROM User WHERE Profile.UserLicense.Name = 'Einstein Agent' AND IsActive = true LIMIT 5"
    default_agent_user: "velo_voice_agent@example.com"

variables:
    # ---- Linked (populated by the platform at runtime) ----
    end_user_id: linked string
        description: "Messaging/voice end-user id for the current session"
        source: @MessagingSession.MessagingEndUserId

    # ---- Lead qualification ----
    caller_name: mutable string = ""
        description: "The caller's full name"
    caller_city: mutable string = ""
        description: "The caller's city"
    interested_model: mutable string = ""
        description: "The Velo vehicle the caller is interested in (e.g. Ranger, Stallion-N, Orion X5)"
    budget_range: mutable string = ""
        description: "The caller's approximate budget range"
    purchase_timeline: mutable string = ""
        description: "When the caller plans to buy (e.g. this month, 3 months)"
    current_vehicle: mutable string = ""
        description: "The caller's current vehicle, if any"
    is_lead_qualified: mutable boolean = False
        description: "True once name, city and model of interest are captured"

    # ---- Test ride booking ----
    preferred_dealer_name: mutable string = ""
        description: "Dealership the caller prefers, as spoken"
    testride_model: mutable string = ""
        description: "Model the caller wants to test-ride"
    testride_date: mutable string = ""
        description: "Preferred test-ride date, as spoken by the caller"
    testride_time: mutable string = ""
        description: "Preferred test-ride time, as spoken by the caller"
    booking_id: mutable string = ""
        description: "Test-ride booking confirmation number (mock until a booking action is wired)"
    is_booking_confirmed: mutable boolean = False
        description: "True once the test ride is booked"

    # ---- WhatsApp passport (mockup) ----
    passport_qr_url: mutable string = ""
        description: "URL of the QR passport image (mock until a send action is wired)"
    is_passport_sent: mutable boolean = False
        description: "True once the passport has been sent to WhatsApp"

connection messaging:
    escalation_message: "मैं आपको हमारे सेल्स सलाहकार से जोड़ रही हूँ, कृपया लाइन पर बने रहें।"

language:
    default_locale: "hi_IN"
    additional_locales: "en_US"
    all_additional_locales: False

start_agent agent_router:
    description: "Greet the inbound caller in Hindi and route to the right subagent. Router only — never answer questions here."
    reasoning:
        instructions: |
            You are a router only. Do NOT answer questions or collect details yourself — route immediately.
            Greet the caller warmly in Hindi, then choose a route:
            - A new caller, or anyone interested in a Velo vehicle → lead qualification.
            - A caller whose details are already captured and who wants to book/manage a test ride → test-ride booking.
            - A caller who explicitly asks for a human/sales advisor → escalation.
            - Anything unrelated to Velo vehicles or test rides → off-topic.
        actions:
            to_qualify: @utils.transition to @subagent.lead_qualification
                description: "New caller or interest in a Velo vehicle; qualify the lead"
            to_testride: @utils.transition to @subagent.test_ride_booking
                description: "Caller wants to book or manage a test ride"
                available when @variables.is_lead_qualified == True
            to_human: @utils.transition to @subagent.escalation
                description: "Caller asks to speak with a human sales advisor"
            to_off_topic: @utils.transition to @subagent.off_topic
                description: "Request unrelated to Velo vehicles or test rides"

subagent lead_qualification:
    label: "Lead Qualification"
    description: "Collects the caller's details in Hindi — name, city, model interest, budget, timeline — and qualifies the lead."

    reasoning:
        instructions: ->
            | आपके लिए सही Velo गाड़ी चुनने के लिए कुछ जानकारी लूँगी — एक-एक करके पूछूँगी।
              अब तक मिली जानकारी — नाम: {!@variables.caller_name}, शहर: {!@variables.caller_city}, पसंदीदा मॉडल: {!@variables.interested_model}, बजट: {!@variables.budget_range}, कब तक खरीदना है: {!@variables.purchase_timeline}।
              जो जानकारी अभी बाकी है, केवल वही विनम्रता से पूछें — एक बार में सिर्फ़ एक सवाल। नाम, शहर और पसंदीदा मॉडल ज़रूरी हैं।

        actions:
            collect_details: @utils.setVariables
                description: "Capture the caller's lead details as they are shared during the call"
                with caller_name = ...
                with caller_city = ...
                with interested_model = ...
                with budget_range = ...
                with purchase_timeline = ...
                with current_vehicle = ...

            back: @utils.transition to @subagent.agent_router
                description: "Return to routing if the caller changes the topic"

    after_reasoning:
        # Once the required details are captured, mark the lead qualified and move to booking.
        if @variables.caller_name != "" and @variables.caller_city != "" and @variables.interested_model != "":
            set @variables.is_lead_qualified = True
            transition to @subagent.test_ride_booking

subagent test_ride_booking:
    label: "Test Ride Booking"
    description: "Books a test ride for a qualified lead — captures preferred dealership, model, date and time."

    reasoning:
        instructions: ->
            | बढ़िया {!@variables.caller_name} जी, अब टेस्ट राइड बुक करती हूँ।
              काॅलर से पसंदीदा डीलरशिप या इलाका, टेस्ट राइड का मॉडल, तारीख़ और समय एक-एक करके पूछें — एक बार में सिर्फ़ एक सवाल।
              अगर मॉडल पहले से पता है ({!@variables.interested_model}), तो उसी की पुष्टि करें।
              अब तक — डीलरशिप: {!@variables.preferred_dealer_name}, मॉडल: {!@variables.testride_model}, तारीख़: {!@variables.testride_date}, समय: {!@variables.testride_time}।

        actions:
            collect_booking: @utils.setVariables
                description: "Capture the preferred dealership, test-ride model, date and time"
                with preferred_dealer_name = ...
                with testride_model = ...
                with testride_date = ...
                with testride_time = ...

            back: @utils.transition to @subagent.agent_router
                description: "Return to routing"

    after_reasoning:
        # Once model, date and time are captured, confirm the booking (mock id) and move to the passport step.
        if @variables.testride_model != "" and @variables.testride_date != "" and @variables.testride_time != "":
            set @variables.booking_id = "MH-TR-DEMO-001"
            set @variables.is_booking_confirmed = True
            transition to @subagent.send_passport

subagent send_passport:
    label: "Send WhatsApp Passport"
    description: "Confirms the booking and 'sends' the QR test-ride passport to the caller's WhatsApp — mockup."

    before_reasoning:
        # No backing action yet — mock the passport as sent.
        set @variables.passport_qr_url = "https://example.com/velo/testride-passport-demo.png"
        set @variables.is_passport_sent = True

    reasoning:
        instructions: ->
            | काॅलर को Hindi में बताएं कि टेस्ट राइड कन्फर्म हो गई है, बुकिंग नंबर {!@variables.booking_id}।
              फिर बताएं कि एक डिजिटल पासपोर्ट — एक QR कोड — उनके WhatsApp पर भेज दिया गया है, जिसे दिखाकर वे डीलरशिप पर तेज़ चेक-इन कर सकते हैं।
              अंत में Velo को चुनने के लिए धन्यवाद कहें और शुभकामनाएँ दें। सब कुछ छोटे, बोलचाल वाले वाक्यों में।

        actions:
            back: @utils.transition to @subagent.agent_router
                description: "Return to routing after the passport is delivered"

subagent escalation:
    label: "Escalation"
    description: "Handles callers who explicitly ask to speak with a human sales advisor."

    reasoning:
        instructions: ->
            | अगर काॅलर किसी इंसानी सेल्स सलाहकार से बात करना चाहता है, तो बातचीत को ट्रांसफ़र करें।
        actions:
            escalate_to_human: @utils.escalate
                description: "Transfer the call to a human sales advisor"

subagent off_topic:
    label: "Off Topic"
    description: "Redirects the caller back to Velo vehicles and test-ride help when the request is off-topic."

    reasoning:
        instructions: ->
            | काॅलर का सवाल हमारे विषय से बाहर है। सामान्य ज्ञान के सवालों के जवाब न दें।
              विनम्रता से बताएं कि आप Velo गाड़ियों की जानकारी और टेस्ट राइड बुकिंग में मदद कर सकती हैं, और पूछें कि इनमें कैसे मदद करें।
        actions:
            back: @utils.transition to @subagent.agent_router
                description: "Return to routing"
