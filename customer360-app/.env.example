# Copy to .env.local and fill in. Leave SF_* empty to run on built-in mock data.
# Never commit .env.local.

# My Domain URL of the Salesforce org that hosts the External Client App (no trailing slash)
SF_LOGIN_URL=https://your-domain.my.salesforce.com
# Consumer Key of the External/Connected App (OAuth client credentials flow)
SF_CLIENT_ID=
# Consumer Secret of the same app (server-side only, never exposed to the browser)
SF_CLIENT_SECRET=
# Salesforce REST API version used by the proxy
SF_API_VERSION=61.0
# Set to "true" to force mock data even when SF_* are configured
USE_MOCK=
# Id of a Nudge__c record that receives the latest nudge (optional; sync is skipped when empty)
SF_NUDGE_RECORD_ID=
# Session label written to Nudge__c.Session_Id__c
SF_NUDGE_SESSION_ID=Demo-001
# Apex REST path of the nudge endpoint (de_H360NudgeService)
SF_NUDGE_APEX_PATH=/services/apexrest/nudge
